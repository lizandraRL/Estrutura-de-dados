Exercício 2 — Fila de Supermercado

import java.util.Queue;
import java.util.LinkedList;

public class Exercicio2 {
    public static void main(String[] args) {

        Queue<String> filaClientes = new LinkedList<>();

        filaClientes.offer("João");
        filaClientes.offer("Maria");
        filaClientes.offer("Pedro");
        filaClientes.offer("Ana");
        filaClientes.offer("Carlos");

        System.out.println("Fila inicial: " + filaClientes);
        System.out.println();

        int atendidos = 0;

        while (!filaClientes.isEmpty()) {
            String cliente = filaClientes.poll();
            System.out.println("Atendendo: " + cliente);
            atendidos++;
        }

        System.out.println();
        System.out.println("Total de clientes atendidos: " + atendidos);
        System.out.println("Fila final: " + filaClientes);
    }
}

