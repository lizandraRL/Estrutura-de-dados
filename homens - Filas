Exercício 7 — Fila de Impressão com Cancelamento

import java.util.LinkedList;
import java.util.Scanner;

class Documento {

    private static int contador = 1;

    int id;
    String nomeDocumento;
    String usuario;

    public Documento(String nomeDocumento, String usuario) {
        this.id = contador++;
        this.nomeDocumento = nomeDocumento;
        this.usuario = usuario;
    }

    @Override
    public String toString() {
        return id + "-" + nomeDocumento + "(" + usuario + ")";
    }
}

public class Exercicio7 {

    public static void main(String[] args) {

        LinkedList<Documento> fila = new LinkedList<>();
        Scanner scanner = new Scanner(System.in);

        int opcao;

        do {

            System.out.println("\n--- FILA DE IMPRESSÃO ---");
            System.out.println("1 - Adicionar documento");
            System.out.println("2 - Imprimir próximo");
            System.out.println("3 - Cancelar documento");
            System.out.println("4 - Ver fila");
            System.out.println("5 - Sair");

            System.out.print("Escolha: ");
            opcao = Integer.parseInt(scanner.nextLine());

            switch (opcao) {

                case 1:

                    System.out.print("Nome do documento: ");
                    String nome = scanner.nextLine();

                    System.out.print("Usuário: ");
                    String usuario = scanner.nextLine();

                    Documento doc = new Documento(nome, usuario);

                    fila.offer(doc);

                    System.out.println(
                        "Documento #" + doc.id
                        + " adicionado."
                    );

                    break;

                case 2:

                    if (fila.isEmpty()) {
                        System.out.println("Fila vazia!");
                    } else {

                        Documento impresso = fila.poll();

                        System.out.println(
                            "Imprimindo: "
                            + impresso
                        );
                    }

                    break;

                case 3:

                    if (fila.isEmpty()) {
                        System.out.println("Fila vazia!");
                        break;
                    }

                    System.out.print(
                        "ID do documento a cancelar: "
                    );

                    int id = Integer.parseInt(
                        scanner.nextLine()
                    );

                    Documento encontrado = null;

                    for (Documento d : fila) {

                        if (d.id == id) {
                            encontrado = d;
                            break;
                        }
                    }

                    if (encontrado != null) {

                        fila.remove(encontrado);

                        System.out.println(
                            "Documento cancelado: "
                            + encontrado
                        );

                    } else {

                        System.out.println(
                            "Documento não encontrado!"
                        );
                    }

                    break;

                case 4:

                    System.out.println("Fila: " + fila);

                    break;

                case 5:

                    System.out.println("Encerrando...");
                    break;

                default:

                    System.out.println("Opção inválida!");
            }

        } while (opcao != 5);

        scanner.close();
    }
}


