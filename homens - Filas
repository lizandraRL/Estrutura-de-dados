Exercício 6 — Processador de Tarefas com Prioridade Personalizada
import java.util.PriorityQueue;

class Tarefa implements Comparable<Tarefa> {

    String nome;
    int prioridade;
    long timestamp;

    public Tarefa(String nome, int prioridade, long timestamp) {
        this.nome = nome;
        this.prioridade = prioridade;
        this.timestamp = timestamp;
    }

    @Override
    public int compareTo(Tarefa outra) {

        // Primeiro pela prioridade
        if (this.prioridade != outra.prioridade) {
            return Integer.compare(this.prioridade, outra.prioridade);
        }

        // Depois pela ordem de chegada
        return Long.compare(this.timestamp, outra.timestamp);
    }

    @Override
    public String toString() {
        return nome + " (Prioridade: " + prioridade + ")";
    }
}

public class Exercicio6 {

    static long contador = 0;

    public static void main(String[] args) {

        PriorityQueue<Tarefa> fila = new PriorityQueue<>();

        fila.offer(new Tarefa("Fazer backup", 2, contador++));
        fila.offer(new Tarefa("Reiniciar servidor", 1, contador++));
        fila.offer(new Tarefa("Limpar logs", 3, contador++));
        fila.offer(new Tarefa("Atualizar sistema", 1, contador++));
        fila.offer(new Tarefa("Responder emails", 2, contador++));

        System.out.println("=== EXECUTANDO TAREFAS ===");

        int ordem = 1;

        while (!fila.isEmpty()) {

            System.out.println(
                ordem + ". " + fila.poll()
            );

            ordem++;
        }
    }
}
