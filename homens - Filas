Exercício 3 — Menu de Atendimento

import java.util.Queue;
import java.util.LinkedList;
import java.util.Scanner;

public class Exercicio3 {
    public static void main(String[] args) {

        Queue<String> fila = new LinkedList<>();
        Scanner scanner = new Scanner(System.in);

        while (true) {

            System.out.print(
                "\nDigite um nome, 'atender', 'fila' ou 'sair': "
            );

            String comando = scanner.nextLine();

            if (comando.equalsIgnoreCase("sair")) {

                System.out.println("Encerrando...");
                break;

            } else if (comando.equalsIgnoreCase("fila")) {

                System.out.println("Fila atual: " + fila);

            } else if (comando.equalsIgnoreCase("atender")) {

                if (fila.isEmpty()) {
                    System.out.println("Fila vazia!");
                } else {
                    System.out.println("Atendendo: " + fila.poll());
                }

            } else {

                fila.offer(comando);
                System.out.println(comando + " entrou na fila.");
            }
        }

        scanner.close();
    }
}

